# ──────────────────────────────────────────────────────────────────
# BondBlueprint™ — Environment Variables
# Copy this file to ".env" and fill in every value before running.
# ──────────────────────────────────────────────────────────────────

# ── ANTHROPIC (Claude AI) ─────────────────────────────────────────
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── STRIPE ────────────────────────────────────────────────────────
# Get at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_YOUR_KEY_HERE

# Create a Product + Price in Stripe dashboard, paste the price ID here
# e.g. price_1ABC123...
STRIPE_PRICE_ID=price_YOUR_PRICE_ID_HERE

# Get from: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
# Local testing: run  stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ── SUPABASE (Database) ───────────────────────────────────────────
# Get at: https://supabase.com → your project → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...YOUR_SERVICE_ROLE_KEY_HERE

# ── RESEND (Transactional Email) ──────────────────────────────────
# Get at: https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_KEY_HERE

# The "From" address — must match a domain you've verified in Resend
# Verify coupleseducator.com at: https://resend.com/domains
EMAIL_FROM=Ashley @ CouplesEducator <hello@coupleseducator.com>

# ── CONVERTKIT (Email Marketing) ─────────────────────────────────
# Get at: https://app.convertkit.com/account_settings/advanced_settings
CONVERTKIT_API_KEY=YOUR_CONVERTKIT_API_KEY_HERE

# The form ID to subscribe leads to (find in ConvertKit → Forms → your form URL)
CONVERTKIT_FORM_ID=YOUR_FORM_ID_HERE

# Tag IDs (create these in ConvertKit → Subscribers → Tags):
#   quiz_lead        — anyone who completes the quiz and gives email
#   viewed_checkout  — anyone who clicked "Get Blueprint" (for abandoned cart sequence)
#   paid             — anyone who completed payment (removes from abandoned cart)
CONVERTKIT_QUIZ_TAG_ID=YOUR_TAG_ID_HERE
CONVERTKIT_CHECKOUT_TAG_ID=YOUR_TAG_ID_HERE
CONVERTKIT_PAID_TAG_ID=YOUR_TAG_ID_HERE

# ── SERVER ────────────────────────────────────────────────────────
PORT=3000
